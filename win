# ==========================================================
# CrazyAlexTool launcher
# ==========================================================
# This tiny file only forwards to the real script hosted in
# the CrazyAlexTool repository. When CrazyAlexTool.ps1 is
# updated, users automatically get the new version without
# any change here.
# ==========================================================

$ScriptUrl = "https://raw.githubusercontent.com/CrazyAlex15/CrazyAlexTool/main/CrazyAlexTool.ps1"

try {
    Write-Host "[i] Downloading CrazyAlexTool..." -ForegroundColor Cyan

    $response = Invoke-WebRequest `
        -Uri $ScriptUrl `
        -UseBasicParsing `
        -ErrorAction Stop

    $code = [string]$response.Content

    if ([string]::IsNullOrWhiteSpace($code)) {
        throw "Downloaded script was empty."
    }

    $trimmed = $code.TrimStart()

    if (
        $trimmed -match '^<!DOCTYPE\s+html' -or
        $trimmed -match '^<html\b'
    ) {
        throw "The URL returned an HTML page instead of PowerShell."
    }

    Write-Host "[i] Executing CrazyAlexTool..." -ForegroundColor Cyan
    Invoke-Expression $code
}
catch {
    Write-Host "[x] Failed to launch CrazyAlexTool: $($_.Exception.Message)" `
        -ForegroundColor Red
}
