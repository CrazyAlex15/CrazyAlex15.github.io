# ==========================================================
# CrazyAlexTool launcher
# ==========================================================
# This tiny file only forwards to the real script hosted in
# the CrazyAlexTool repository. That means when you improve
# CrazyAlexTool.ps1, users automatically get the new version
# without any change here.
# ==========================================================

$ScriptUrl = "https://raw.githubusercontent.com/CrazyAlex15/CrazyAlexTool/main/CrazyAlexTool.ps1"

try {
    Write-Host "[i] Downloading CrazyAlexTool..." -ForegroundColor Cyan

    $code = Invoke-WebRequest `
        -Uri $ScriptUrl `
        -UseBasicParsing `
        -ErrorAction Stop |
        Select-Object -ExpandProperty Content

    if ([string]::IsNullOrWhiteSpace($code)) {
        throw "Downloaded script was empty."
    }

    if ($code -match "(?is)<html\b|<head\b|<body\b") {
        throw "The URL returned HTML instead of PowerShell."
    }

    Invoke-Expression $code
}
catch {
    Write-Host "[x] Failed to launch CrazyAlexTool: $($_.Exception.Message)" `
        -ForegroundColor Red
}
